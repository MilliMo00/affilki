generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Контент ────────────────────────────────────────────────────────────────

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  title    String
  order    Int       @default(0)
  articles Article[]
}

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  contentHtml String
  /// Исходник в простой разметке (## заголовки, списки, ссылки). HTML выше собирается из него.
  contentSource String?
  coverUrl    String?
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  authorName  String        @default("AFFILKI")
  readingMin  Int
  views       Int           @default(0)
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ── Премия ─────────────────────────────────────────────────────────────────

model Season {
  id               String   @id @default(cuid())
  year             Int      @unique
  title            String
  stage            Stage    @default(APPLICATIONS)
  votingStartsAt   DateTime
  votingEndsAt     DateTime
  /// Дата начала следующего этапа — для индикатора-цветка.
  nextStageAt      DateTime?
  resultsPublished Boolean  @default(false)
  /// По умолчанию побеждает тот, за кого больше голосов; жюри включается весом > 0.
  communityWeight  Float    @default(1)
  juryWeight       Float    @default(0)

  // Пороги защиты (ТЗ v2, 4.3)
  requireChannel  Boolean @default(true)
  requireUsername Boolean @default(false)
  requireAvatar   Boolean @default(false)
  /// Голосуют аккаунты с Telegram ID не больше порога: чем меньше ID, тем старше аккаунт.
  maxTelegramId   BigInt?

  // Live-результаты (ТЗ v2, 3.1)
  liveEnabled             Boolean  @default(true)
  liveMode                LiveMode @default(PERCENT)
  liveRefreshSec          Int      @default(15)
  liveMinVotes            Int      @default(30)
  liveFreezeHours         Int      @default(48)
  liveShowJury            Boolean  @default(false)
  maxVotesPerTenMinFactor Float    @default(3)

  nominations Nomination[]
}

enum Stage {
  APPLICATIONS
  SHORTLIST
  VOTING
  COUNTING
  CEREMONY
}

enum LiveMode {
  PERCENT
  COUNTS
}

model Nomination {
  id                  String   @id @default(cuid())
  seasonId            String
  season              Season   @relation(fields: [seasonId], references: [id])
  slug                String
  order               Int      @default(0)
  title               String
  /// Одна строка для карточки.
  shortDesc           String
  description         String
  /// string[] из 3–5 пунктов.
  criteria            Json
  eligibility         String
  /// Имя иконки lucide.
  icon                String
  group               NomGroup
  /// Состав жюри номинации, если заполнен.
  jury                String?
  /// Участник не публикуется, пока админ не отметит «Проверено» (номинация «Скандал года»).
  requiresLegalReview Boolean  @default(false)
  acceptingEntries    Boolean  @default(true)
  nominees            Nominee[]
  votes               Vote[]

  @@unique([seasonId, slug])
}

enum NomGroup {
  TEAMS
  MEDIA
  MARKET
}

model Nominee {
  id           String     @id @default(cuid())
  nominationId String
  nomination   Nomination @relation(fields: [nominationId], references: [id])
  slug         String     @unique
  name         String
  logoUrl      String?
  tagline      String?
  description  String?
  /// { site?: string, tg?: string }
  links        Json?
  juryScore    Float?
  /// string[] ссылок на публичные источники — обязательны там, где requiresLegalReview.
  sources      Json?
  /// Комментарий упомянутой стороны.
  rightOfReply String?
  legalChecked Boolean    @default(false)
  published    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  votes        Vote[]

  @@index([nominationId])
}

// ── Вход и голосование ─────────────────────────────────────────────────────
// Схема: один раз подтверждаем себя в Telegram-боте, дальше голосуем на сайте.

/// Одноразовая ссылка входа: сайт создаёт, бот привязывает к Telegram-аккаунту.
model LoginIntent {
  id            String       @id @default(cuid())
  /// Параметр /start у бота. Знать его мало: сессию получает только браузер с секретом.
  token         String       @unique
  /// Хэш секрета из cookie браузера, который начал вход.
  browserHash   String
  status        IntentStatus @default(PENDING)
  /// voter — вход голосующего, admin — первый фактор входа в админку.
  purpose       String       @default("voter")
  tgUserId      BigInt?
  tgUsername    String?
  tgFirstName   String?
  hasAvatar     Boolean      @default(false)
  ipHash        String
  uaHash        String
  /// «Chrome, macOS» — показываем в боте, чтобы человек узнал свой браузер.
  uaLabel       String
  createdAt     DateTime     @default(now())
  expiresAt     DateTime

  @@index([ipHash, createdAt])
}

enum IntentStatus {
  PENDING
  BOUND
  CONFIRMED
  USED
  REJECTED
}

model VoterSession {
  /// SHA-256 от токена из cookie: сам токен в базе не хранится.
  id          String    @id
  tgUserId    BigInt
  tgUsername  String?
  tgFirstName String?
  hasAvatar   Boolean   @default(false)
  ipHash      String
  uaHash      String
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([tgUserId])
}

model Vote {
  id           String     @id @default(cuid())
  tgUserId     BigInt
  tgUsername   String?
  hasAvatar    Boolean
  nominationId String
  nomination   Nomination @relation(fields: [nominationId], references: [id])
  nomineeId    String
  nominee      Nominee    @relation(fields: [nomineeId], references: [id])
  ipHash       String
  uaHash       String
  captchaKind  String     @default("turnstile")
  voidedAt     DateTime?
  voidReason   String?
  voidedBy     String?
  createdAt    DateTime   @default(now())

  /// Один Telegram-аккаунт — один голос в номинации: гарантия на уровне базы.
  @@unique([tgUserId, nominationId])
  @@index([nomineeId, createdAt])
}

model TgBan {
  tgUserId  BigInt   @id
  reason    String
  createdBy String
  createdAt DateTime @default(now())
}

// ── Аналитика ──────────────────────────────────────────────────────────────

/// Сырое событие. Хранится 180 дней; IP не хранится — только хэш с солью.
model AnalyticsEvent {
  id          BigInt   @id @default(autoincrement())
  type        String
  ts          DateTime @default(now())
  /// Анонимный идентификатор вкладки/визита.
  sessionId   String?
  /// Анонимный идентификатор посетителя; есть только при согласии на аналитические cookie.
  visitorId   String?
  path        String?
  entityType  String?
  entityId    String?
  ipHash      String?
  device      String?
  browser     String?
  os          String?
  country     String?
  /// Только домен источника перехода.
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  meta        Json?

  @@index([type, ts])
  @@index([entityType, entityId, ts])
  @@index([ts])
}

/// Суточный агрегат для дашбордов. Пустая строка вместо NULL — чтобы работал уникальный индекс.
model DailyStat {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  type       String
  entityType String   @default("")
  entityId   String   @default("")
  source     String   @default("")
  device     String   @default("")
  count      Int
  uniques    Int

  @@unique([date, type, entityType, entityId, source, device])
  @@index([type, date])
}

// ── Админка ────────────────────────────────────────────────────────────────

model AdminUser {
  id             String    @id @default(cuid())
  tgId           BigInt    @unique
  name           String
  role           AdminRole
  /// Секрет TOTP, зашифрованный AES-256-GCM ключом ADMIN_ENC_KEY.
  totpSecretEnc  String?
  /// Секрет на этапе настройки: становится основным после первого верного кода.
  totpPendingEnc String?
  /// Последний использованный шаг TOTP — один код нельзя ввести дважды.
  lastTotpStep   Int?
  /// Хэши (argon2id) одноразовых резервных кодов.
  backupCodes    Json?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  sessions       AdminSession[]
}

enum AdminRole {
  OWNER
  EDITOR
  ANALYST
}

model AdminSession {
  /// SHA-256 от токена из cookie.
  id         String    @id
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  uaHash     String
  ipHash     String
  uaLabel    String    @default("")
  country    String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([adminId])
}

/// Журнал действий админов. Записи только добавляются: кода, который их меняет или удаляет, нет.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  adminId    String
  adminName  String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipHash     String
  ts         DateTime @default(now())

  @@index([ts])
  @@index([entityType, entityId])
}

// ── Заявки на публикацию ───────────────────────────────────────────────────
// Человек входит через бота и подаёт заявку: на участие в номинации или на статью.
// Админ правит, одобряет (тогда создаётся участник или статья) либо возвращает с правками.

model Submission {
  id           String           @id @default(cuid())
  kind         SubmissionKind
  status       SubmissionStatus @default(PENDING)
  /// Автор: Telegram-аккаунт, вошедший через бота. Ему же уходят уведомления.
  tgUserId     BigInt
  tgUsername   String?
  authorName   String
  contact      String
  title        String
  text         String
  imageUrl     String?
  /// string[] ссылок автора.
  links        Json
  /// Для заявки в номинацию.
  nominationId String?
  /// Для статьи: slug рубрики.
  categorySlug String?
  /// Комментарий модератора при возврате или отказе — виден автору.
  adminComment String?
  /// Что получилось после одобрения: id участника или статьи.
  resultId     String?
  ipHash       String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([tgUserId])
}

enum SubmissionKind {
  NOMINEE
  ARTICLE
}

enum SubmissionStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

// ── Реклама ────────────────────────────────────────────────────────────────

/// Проданное размещение в слоте. Слот считается проданным, пока сейчас внутри startsAt–endsAt.
model AdCampaign {
  id              String    @id @default(cuid())
  slotKey         String
  advertiser      String
  imageUrl        String
  mobileImageUrl  String?
  targetUrl       String
  startsAt        DateTime
  endsAt          DateTime
  /// Подписанная ссылка на отчёт для рекламодателя.
  reportToken     String?   @unique
  reportExpiresAt DateTime?
  createdAt       DateTime  @default(now())

  @@index([slotKey, startsAt, endsAt])
}
